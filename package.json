{
  "name": "by-the-whey",
  "version": "0.2.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "release": "eas build --platform ios --profile production --auto-submit --wait && eas build --platform android --profile production --wait",
    "release:ios": "eas build --platform ios --profile production --auto-submit",
    "release:android": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.110.8",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "react": "^19.2.3",
    "react-native": "^0.86.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  }
}
